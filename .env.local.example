# Copy this file to .env.local and fill in the values below.
# .env.local is already git-ignored — never commit real secrets.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase project settings -> API -> service_role key.
# SECRET — server-only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for logging into /admin. Pick your own.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too

# Optional. Direct Postgres connection string, only used by
# scripts/run-migration.mjs to run SQL migration files. Get it from the
# Supabase dashboard -> Connect -> Session pooler.
SUPABASE_DB_URL=

# When "true", the public site shows hardcoded sample products/brands instead
# of querying Supabase — /admin is unaffected either way. Leave unset
# (or "false") for real production use.
DEMO_MODE=false
